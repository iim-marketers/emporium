NEXT_PUBLIC_SITE_URL="https://emporium-gray.vercel.app"

# Recommended for most uses
DATABASE_URL=
# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=

# Parameters for constructing your own connection string
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Parameters for Vercel Postgres Templates
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

# Payload CMS
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Admin panel login. Change the password here and it takes effect on next boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=
